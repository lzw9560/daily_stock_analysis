# ===================================
# A股自选股智能分析系统 - .dockerignore
# ===================================

# Python 缓存
__pycache__/
*.py[cod]
*$py.class
*.so

# 虚拟环境
venv/
.venv/
.venv311/
env/

# IDE / 编辑器
.idea/
.vscode/
*.swp
*.swo

# 运行时数据（通过 volume 挂载）
data/
logs/
reports/

# 测试
test_*.py
*_test.py
.pytest_cache/
tests/

# 文档（保留 README.md 和 DEPLOY.md）
*.md
!README.md
!DEPLOY.md

# 前端 node_modules / dist（多阶段构建自行处理）
apps/dsa-web/node_modules/
apps/dsa-web/dist/

# 其他
.git/
.gitignore
.github/
*.profraw
brewlog.txt
iterm2-setup/
node_modules/
package-lock.json
!apps/dsa-web/package-lock.json
.claude/
.codebuddy/
scripts/
# docker/ 目录自身会被 COPY 的特定文件引用，不整体排除
# 但排除非必要文件
docker/*.md

# 环境变量（通过 docker-compose env_file 注入）
.env
.env.*
